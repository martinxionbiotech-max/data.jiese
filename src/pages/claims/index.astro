---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import TypeBadge from "../../../shared/components/TypeBadge.astro";
import { getCollection } from 'astro:content';
import { DATA_SITE_URL, MAIN_SITE_URL } from "../../../shared/config/config";

const claims = (await getCollection('claims')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const statusOrder = ['supported', 'partially-supported', 'mixed', 'limited', 'not-established', 'contradicted', 'unknown'];
const statusLabel: Record<string, string> = {
  supported: 'Supported', 'partially-supported': 'Partially Supported', mixed: 'Mixed Evidence',
  limited: 'Limited Evidence', 'not-established': 'Not Established', contradicted: 'Contradicted', unknown: 'Unknown',
};
---
<BaseLayout
  siteTitle="Porn Recovery Research & Knowledge Library"
  siteUrl={DATA_SITE_URL}
  title="Claims Database — Statements Evaluated Against Evidence"
  description="A structured database of common claims about pornography use and recovery, each evaluated against current evidence with explicit status, strength, and uncertainty."
  canonical="/claims/"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Claims", url: "/claims/" }]}
>
  <h1>Claims Database</h1>
  <p>Common statements about pornography use and recovery, each evaluated against the
  current evidence. A claim's status is about the evidence — not a judgment on the people
  who make it.</p>
  <p class="note">Statuses: <strong>Supported</strong> · Partially Supported · Mixed Evidence ·
  Limited Evidence · <strong>Not Established</strong> · Contradicted · Unknown.
  "Not established" means evidence is insufficient — not that the claim is false.</p>
  <table class="data-table">
    <thead><tr><th>Claim</th><th>Status</th><th>Evidence</th></tr></thead>
    <tbody>
      {claims.map((c) => (
        <tr>
          <td><a href={`/claims/${c.data.claim_id}/`}>{c.data.claim}</a></td>
          <td>{statusLabel[c.data.status]}</td>
          <td>{c.data.evidence_strength}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p><a href={MAIN_SITE_URL}>Back to main site</a> · <a href="/evidence/">Evidence standards</a> · <a href="/controversies/">Controversies</a></p>
</BaseLayout>
