---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { getCollection } from 'astro:content';
import { DATA_SITE_URL, MAIN_SITE_URL } from "../../../shared/config/config";

// 只统计真实记录（排除 synthetic）
const experiences = await getCollection('experiences')
  .then((all) => all.filter((e) => e.data.privacy_status !== "synthetic"));
const realCount = experiences.length;

// 聚合函数
const count = (arr: string[]) => arr.filter((x, i) => arr.indexOf(x) === i).map((k) => ({
  key: k, n: arr.filter((x) => x === k).length,
}));

const triggerCounts = count(experiences.flatMap((e) => e.data.triggers ?? [])).sort((a, b) => b.n - a.n);
const strategyCounts = count(experiences.flatMap((e) => e.data.strategies ?? [])).sort((a, b) => b.n - a.n);
const stageCounts = count(experiences.map((e) => e.data.recovery_stage ?? "Not specified").filter(Boolean)).sort((a, b) => b.n - a.n);
---
<BaseLayout
  siteTitle="Porn Recovery Research & Knowledge Library"
  siteUrl={DATA_SITE_URL}
  title="Community Statistics — Recovery Experience Data"
  description="Aggregated statistics from de-identified community recovery experiences. Community sample — not representative of any general population."
  canonical="/statistics/"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Statistics", url: "/statistics/" }]}
>
  <h1>Community Statistics</h1>
  <p class="note"><strong>Sample size: {realCount} real community experience record{realCount === 1 ? "" : "s"}.</strong>
  This is a <strong>community sample</strong> — self-selected people sharing recovery experiences.
  It is <strong>not</strong> a representative population sample and cannot support statistical
  generalization or medical inference.</p>

  {realCount === 0 ? (
    <p>No real community experience records have been ingested yet.
    Statistics will appear here once the ingestion pipeline processes real, de-identified
    records. Synthetic example records are excluded from all statistics by design.</p>
  ) : (
    <>
      <h2>Most frequently reported triggers</h2>
      {triggerCounts.length > 0 ? (
        <ul>{triggerCounts.map((t) => <li>{t.key.replaceAll("-", " ")} — {t.n} record{t.n === 1 ? "" : "s"}</li>)}</ul>
      ) : <p>No trigger data yet.</p>}

      <h2>Most common recovery strategies</h2>
      {strategyCounts.length > 0 ? (
        <ul>{strategyCounts.map((s) => <li>{s.key.replaceAll("-", " ")} — {s.n} record{s.n === 1 ? "" : "s"}</li>)}</ul>
      ) : <p>No strategy data yet.</p>}

      <h2>Recovery stage distribution</h2>
      {stageCounts.length > 0 ? (
        <ul>{stageCounts.map((s) => <li>{s.key} — {s.n} record{s.n === 1 ? "" : "s"}</li>)}</ul>
      ) : <p>No stage data yet.</p>}
    </>
  )}

  <h2>Method</h2>
  <p>Statistics are computed from structured experience records only. Synthetic demonstration
  records are always excluded. Counts reflect the number of records mentioning each item —
  one record may mention several triggers or strategies.</p>
  <p><a href={MAIN_SITE_URL + "/experiences/"}>Browse experiences</a> ·
  <a href="/claims/">Claims database</a> · <a href="/references/">References</a></p>
</BaseLayout>
