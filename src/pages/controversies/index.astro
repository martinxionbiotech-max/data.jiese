---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { getCollection } from 'astro:content';
import { DATA_SITE_URL, MAIN_SITE_URL } from "../../../shared/config/config";
const controversies = await getCollection('controversies');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Evidence & Controversies",
  url: DATA_SITE_URL + "/controversies/",
  description: "Structured overviews of active scientific debates about pornography use, compulsive sexual behavior, and recovery — positions, evidence, limitations, and what remains uncertain.",
  isPartOf: { "@type": "WebSite", "name": "Porn Recovery Research & Knowledge Library", "url": "https://data.selfcontrolatlas.com" },
};

---
<BaseLayout
  siteTitle="Porn Recovery Research & Knowledge Library"
  siteUrl={DATA_SITE_URL}
  title="Evidence & Controversies"
  description="Structured overviews of active scientific debates about pornography use, compulsive sexual behavior, and recovery — positions, evidence, limitations, and what remains uncertain."
  canonical="/controversies/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Controversies", url: "/controversies/" }]}
>
  <h1>Evidence &amp; Controversies</h1>
  <p>Active debates in the research community, presented with the evidence for each
  position, its limitations, what is well established, and what remains uncertain.
  "Balanced" here means evidence-based — not mechanically 50/50.</p>
  <ul>
    {controversies.map((c) => (
      <li style="margin: var(--space-3) 0;">
        <a href={`/controversies/${c.data.controversy_id}/`}><strong>{c.data.question}</strong></a>
        <p style="margin: 4px 0 0; color: var(--color-text-soft); font-size: 14px;">{c.data.why_controversial}</p>
      </li>
    ))}
  </ul>
  <p><a href="/claims/">Claims database</a> · <a href="/evidence/">Evidence standards</a> · <a href={MAIN_SITE_URL}>Main site</a></p>
</BaseLayout>
